DEEPSEEK_API_KEY=replace_with_your_own_key
DEEPSEEK_MODEL=deepseek-flash
PORT=8765
# 0=不限制模型请求数
DAILY_REQUEST_LIMIT=0
# AI 公开检索：auto=自动检测（优先 Tavily，其次已安装的 ddgs）；off=关闭
SEARCH_PROVIDER=auto
# Tavily 免费 Key（每月1000次，app.tavily.com）；不填则使用 pip install ddgs 的免Key检索
TAVILY_API_KEY=
# 每日检索上限，0=不限
SEARCH_DAILY_LIMIT=40
